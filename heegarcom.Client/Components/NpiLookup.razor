@using System.Net.Http.Json
@inject HttpClient Http

<div class="mx-auto max-w-4xl px-6 pb-24">
    <div class="grid gap-3 sm:grid-cols-3">
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">First name</label>
            <input value="@firstName" @oninput="OnFirst" @onkeydown="OnKey" type="search" autocomplete="off"
                   placeholder="e.g. John"
                   class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">Last name</label>
            <input value="@lastName" @oninput="OnLast" @onkeydown="OnKey" type="search" autocomplete="off"
                   placeholder="e.g. Smith"
                   class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">State</label>
            <select value="@stateText" @onchange="OnState"
                    class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange">
                <option value="">Any state</option>
                @foreach (var s in States)
                {
                    <option value="@s.Code">@s.Code &mdash; @s.Name</option>
                }
            </select>
        </div>
    </div>

    <button @onclick="OnSearch" disabled="@(!CanSearch || loading)"
            class="mt-4 rounded-md bg-orange px-6 py-2.5 text-sm font-medium text-white transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50">
        Search
    </button>

    @if (loading)
    {
        <p class="mt-4 text-sm text-muted">Searching…</p>
    }
    else if (error)
    {
        <p class="mt-4 text-sm text-muted">Lookup failed — please try again.</p>
    }
    else if (searched && rows.Count == 0)
    {
        <p class="mt-4 text-sm text-muted">No matches. Try a last name or a 2-letter state.</p>
    }
    else if (rows.Count > 0)
    {
        <p class="mt-4 text-sm text-muted">@rows.Count result@(rows.Count == 1 ? "" : "s")@(rows.Count == 200 ? " (showing first 200)" : "")</p>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
                <thead>
                    <tr class="border-b border-line text-xs uppercase tracking-widest text-muted">
                        <th class="w-8 py-2"></th>
                        <th class="py-2 pr-4">NPI</th>
                        <th class="py-2 pr-4">Name</th>
                        <th class="py-2 pr-4">Type</th>
                        <th class="py-2 pr-4">Primary specialty</th>
                        <th class="py-2 pr-4">Location</th>
                        <th class="py-2">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var isOpen = expanded.Contains(r.Npi);
                        <tr class="border-b border-line align-top">
                            <td class="py-2 pr-2">
                                <button @onclick="() => ToggleAsync(r.Npi)" aria-label="Toggle provider detail"
                                        class="text-muted transition-colors hover:text-orange">
                                    <span class="inline-block transition-transform @(isOpen ? "rotate-90" : "")">&#9656;</span>
                                </button>
                            </td>
                            <td class="whitespace-nowrap py-2 pr-4 font-mono font-medium text-navy">@r.Npi</td>
                            <td class="py-2 pr-4 text-ink">
                                @r.Name
                                @if (r.Also.Length > 0)
                                {
                                    <span class="block text-xs italic text-muted">@r.Also</span>
                                }
                            </td>
                            <td class="whitespace-nowrap py-2 pr-4 text-muted">@r.Type</td>
                            <td class="py-2 pr-4 text-ink">@r.Specialty</td>
                            <td class="whitespace-nowrap py-2 pr-4 text-muted">@LocationText(r)</td>
                            <td class="whitespace-nowrap py-2 text-muted">@r.Status</td>
                        </tr>
                        @if (isOpen)
                        {
                            var st = details.TryGetValue(r.Npi, out var d) ? d : null;
                            <tr class="border-b border-line bg-navy/5">
                                <td colspan="7" class="px-6 py-5">
                                    @if (st is null || st.Loading)
                                    {
                                        <p class="text-sm text-muted">Loading provider detail…</p>
                                    }
                                    else if (st.Error)
                                    {
                                        <p class="text-sm text-muted">Couldn't load detail — please try again.</p>
                                    }
                                    else
                                    {
                                        var data = st.Data;
                                        @if (data?.Exclusion.Status == "excluded")
                                        {
                                            <div class="mb-4 rounded-md p-3 text-sm" style="border:1px solid #dc2626; background:#fef2f2; color:#991b1b;">
                                                <span class="font-semibold">Federally excluded provider.</span>
                                                The U.S. government has barred this provider from billing Medicare, Medicaid, and other federal health programs.
                                                Reason: @data.Exclusion.Reason@(data.Exclusion.Since is not null ? $", since {data.Exclusion.Since}" : "").
                                                <span class="mt-1 block opacity-80">Source: HHS Office of Inspector General (OIG) exclusion list.</span>
                                            </div>
                                        }
                                        else if (data?.Exclusion.Status == "clear")
                                        {
                                            <p class="mb-4 text-xs text-muted">&#10003; No matching NPI on the federal exclusion list. <span class="opacity-70">Exclusions filed without an NPI won't show in an NPI search — for a high-stakes check, also verify by name and confirm identity. (HHS-OIG)</span></p>
                                        }
                                        else
                                        {
                                            <p class="mb-4 text-xs text-muted">Federal exclusion check unavailable right now — reopen to retry.</p>
                                        }

                                        <div class="grid gap-6 sm:grid-cols-2">
                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">Profile</h4>
                                                @if (data?.Cms.ProfileFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load profile — collapse and reopen to retry.</p>
                                                }
                                                else if (data?.Cms.Profile is { } p)
                                                {
                                                    <p class="mt-3 text-sm text-ink">@p.Specialty@(p.Credential.Length > 0 ? $", {p.Credential}" : "")</p>
                                                    <p class="mt-1 text-xs text-muted">@(p.MedicalSchool.Length > 0 && p.MedicalSchool != "OTHER" ? p.MedicalSchool : "Medical school not reported")@(p.GradYear > 0 ? $" · class of {p.GradYear}" : "")</p>
                                                    <p class="mt-1 text-xs text-muted">@(p.Telehealth ? "Offers telehealth" : "No telehealth")@(p.AcceptsAssignment ? " · accepts Medicare assignment" : "")</p>
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No Care Compare profile on record.</p>
                                                }
                                                @if (data?.Cms.AffiliationsFailed == true)
                                                {
                                                    <p class="mt-1 text-xs text-muted">Affiliations unavailable — collapse and reopen to retry.</p>
                                                }
                                                else if (data?.Cms.Affiliations.Length > 0)
                                                {
                                                    <p class="mt-1 text-xs text-muted">Affiliations: @string.Join(", ", data.Cms.Affiliations)</p>
                                                }
                                            </div>

                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">
                                                    Prescribing@(data?.Cms.PartD is not null ? $" ({data.Cms.PartD.Year})" : "")
                                                </h4>
                                                @if (data?.Cms.PartDFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load prescribing — collapse and reopen to retry.</p>
                                                }
                                                else if (data?.Cms.PartD is { } rx)
                                                {
                                                    <div class="mt-3 grid grid-cols-2 gap-3">
                                                        @Tile($"{rx.TotalClaims:N0}", "Part D claims")
                                                        @Tile($"${rx.TotalDrugCost:N0}", "Drug cost")
                                                    </div>
                                                    @if (rx.OpioidClaims > 0)
                                                    {
                                                        <p class="mt-2 text-xs text-muted">Opioid claims: @rx.OpioidClaims.ToString("N0")@(rx.OpioidRate > 0 ? $" ({rx.OpioidRate:0.#}%)" : "")</p>
                                                    }
                                                    <p class="mt-1 text-xs text-muted">@rx.PrescriberType</p>
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No Part D prescribing on record.</p>
                                                }
                                            </div>

                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">
                                                    Industry payments@(data?.Cms.OpenPayments is not null ? $" ({data.Cms.OpenPayments.Year})" : "")
                                                </h4>
                                                @if (data?.Cms.OpenPaymentsFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load payment data — collapse and reopen to retry.</p>
                                                }
                                                else if (data?.Cms.OpenPayments is { } op)
                                                {
                                                    <div class="mt-3 grid grid-cols-2 gap-3">
                                                        @Tile($"{(op.Capped ? "≥ $" : "$")}{op.TotalReceived:N0}", op.Capped ? "Received (partial)" : "Total received")
                                                        @Tile($"{op.PaymentCount:N0}{(op.Capped ? "+" : "")}", "Payments")
                                                    </div>
                                                    @if (op.TopNatures.Length > 0)
                                                    {
                                                        <p class="mt-2 text-xs text-muted">Top: @string.Join(", ", op.TopNatures)</p>
                                                    }
                                                    @if (op.TopManufacturers.Length > 0)
                                                    {
                                                        <p class="mt-1 text-xs text-muted">From: @string.Join(", ", op.TopManufacturers)</p>
                                                    }
                                                    @if (op.Capped)
                                                    {
                                                        <p class="mt-1 text-xs text-muted">Very high volume — figures reflect the first @op.PaymentCount records.</p>
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No industry payments reported.</p>
                                                }
                                            </div>

                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">
                                                    Medicare quality (MIPS)@(data?.Cms.Mips is not null ? $" ({data.Cms.Mips.Year})" : "")
                                                </h4>
                                                @if (data?.Cms.MipsFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load quality score — collapse and reopen to retry.</p>
                                                }
                                                else if (data?.Cms.Mips is { } m)
                                                {
                                                    <div class="mt-3 grid grid-cols-2 gap-3">
                                                        @Tile($"{m.FinalScore:0.#}", "MIPS score / 100")
                                                        @if (m.QualityScore is not null)
                                                        {
                                                            @Tile($"{m.QualityScore.Value:0.#}", "Quality category / 100")
                                                        }
                                                    </div>
                                                    <p class="mt-2 text-xs text-muted">Medicare's 0&ndash;100 rating of a clinician on quality of care, cost, and care practices. Higher is better; 75+ avoids a Medicare payment penalty.</p>
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No MIPS score on record.</p>
                                                }
                                            </div>
                                        </div>
                                        <p class="mt-4 text-xs text-muted">Sources: CMS Care Compare, Part D &amp; Open Payments, and HHS-OIG — each figure shows its data year.</p>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string firstName = "";
    private string lastName = "";
    private string stateText = "";
    private List<NpiRow> rows = new();
    private bool loading;
    private bool searched;
    private bool error;

    private bool CanSearch => lastName.Trim().Length >= 2 || stateText.Trim().Length == 2;

    private void OnFirst(ChangeEventArgs e) => firstName = e.Value?.ToString() ?? "";
    private void OnLast(ChangeEventArgs e) => lastName = e.Value?.ToString() ?? "";
    private void OnState(ChangeEventArgs e) => stateText = e.Value?.ToString() ?? "";

    private Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            return OnSearch();
        return Task.CompletedTask;
    }

    private async Task OnSearch()
    {
        if (!CanSearch)
            return;

        loading = true;
        error = false;
        expanded.Clear();
        details.Clear();
        StateHasChanged();

        var url = $"api/npi/search?firstName={Uri.EscapeDataString(firstName.Trim())}"
                + $"&lastName={Uri.EscapeDataString(lastName.Trim())}"
                + $"&state={Uri.EscapeDataString(stateText.Trim())}";

        try
        {
            var found = await Http.GetFromJsonAsync<List<NpiRow>>(url);
            rows = found ?? new();
            searched = true;
        }
        catch
        {
            rows = new();
            error = true;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string LocationText(NpiRow r)
    {
        if (r.City.Length > 0 && r.State.Length > 0)
            return $"{r.City}, {r.State}";
        return r.City.Length > 0 ? r.City : r.State;
    }

    // --- Per-provider detail expander (Medicare + Open Payments, lazy-loaded and cached per NPI) ---

    private readonly HashSet<string> expanded = new();
    private readonly Dictionary<string, DetailState> details = new();

    private async Task ToggleAsync(string npi)
    {
        if (expanded.Contains(npi))
        {
            expanded.Remove(npi);
            return;
        }

        expanded.Add(npi);
        // Reuse a successful or in-flight result; re-fetch when the cached result had a retryable failure
        // (a failed section, or an exclusion check that couldn't run) so collapse/reopen actually retries.
        if (details.TryGetValue(npi, out var existing) && (existing.Loading || !Retryable(existing)))
            return;

        var st = new DetailState { Loading = true };
        details[npi] = st;
        StateHasChanged();

        try
        {
            st.Data = await Http.GetFromJsonAsync<ProviderDetails>($"api/npi/details?npi={Uri.EscapeDataString(npi)}");
        }
        catch
        {
            st.Error = true;
        }
        finally
        {
            st.Loading = false;
            StateHasChanged();
        }
    }

    private RenderFragment Tile(string value, string label) => @<div class="rounded-lg bg-white p-3 shadow-sm">
        <div class="text-lg font-bold text-orange">@value</div>
        <div class="mt-0.5 text-xs leading-snug text-muted">@label</div>
    </div>;

    // A cached detail is worth re-fetching when the request itself failed, or any section came back failed,
    // or the exclusion check couldn't run — these are the "collapse and reopen to retry" cases.
    private static bool Retryable(DetailState st)
    {
        if (st.Error || st.Data is null)
            return true;
        if (st.Data.Exclusion.Status == "unavailable")
            return true;
        var c = st.Data.Cms;
        return c.ProfileFailed || c.AffiliationsFailed || c.PartDFailed || c.OpenPaymentsFailed || c.MipsFailed;
    }

    private sealed class DetailState
    {
        public bool Loading;
        public bool Error;
        public ProviderDetails? Data;
    }

    private record NpiRow(string Npi, string Name, string Also, string Type, string Specialty, string City, string State, string Status);

    private record ProviderDetails(ExclusionResult Exclusion, CmsSections Cms);

    private record ExclusionResult(string Status, string? Reason, string? Since);

    private record CmsSections(
        ProviderProfile? Profile, bool ProfileFailed,
        string[] Affiliations, bool AffiliationsFailed,
        PartDSummary? PartD, bool PartDFailed,
        OpenPaymentsSummary? OpenPayments, bool OpenPaymentsFailed,
        MipsSummary? Mips, bool MipsFailed);

    private record ProviderProfile(
        string Credential, string MedicalSchool, int GradYear, string Specialty,
        bool Telehealth, bool AcceptsAssignment);

    private record PartDSummary(
        int Year, string PrescriberType, int TotalClaims, decimal TotalDrugCost,
        int BrandClaims, int GenericClaims, int OpioidClaims, decimal OpioidRate);

    private record OpenPaymentsSummary(
        int Year, decimal TotalReceived, int PaymentCount, bool Capped,
        string[] TopNatures, string[] TopManufacturers);

    private record MipsSummary(int Year, decimal FinalScore, decimal? QualityScore, decimal? CostScore);

    private static readonly (string Code, string Name)[] States =
    {
        ("AL", "Alabama"), ("AK", "Alaska"), ("AZ", "Arizona"), ("AR", "Arkansas"),
        ("CA", "California"), ("CO", "Colorado"), ("CT", "Connecticut"), ("DE", "Delaware"),
        ("FL", "Florida"), ("GA", "Georgia"), ("HI", "Hawaii"), ("ID", "Idaho"),
        ("IL", "Illinois"), ("IN", "Indiana"), ("IA", "Iowa"), ("KS", "Kansas"),
        ("KY", "Kentucky"), ("LA", "Louisiana"), ("ME", "Maine"), ("MD", "Maryland"),
        ("MA", "Massachusetts"), ("MI", "Michigan"), ("MN", "Minnesota"), ("MS", "Mississippi"),
        ("MO", "Missouri"), ("MT", "Montana"), ("NE", "Nebraska"), ("NV", "Nevada"),
        ("NH", "New Hampshire"), ("NJ", "New Jersey"), ("NM", "New Mexico"), ("NY", "New York"),
        ("NC", "North Carolina"), ("ND", "North Dakota"), ("OH", "Ohio"), ("OK", "Oklahoma"),
        ("OR", "Oregon"), ("PA", "Pennsylvania"), ("RI", "Rhode Island"), ("SC", "South Carolina"),
        ("SD", "South Dakota"), ("TN", "Tennessee"), ("TX", "Texas"), ("UT", "Utah"),
        ("VT", "Vermont"), ("VA", "Virginia"), ("WA", "Washington"), ("WV", "West Virginia"),
        ("WI", "Wisconsin"), ("WY", "Wyoming"), ("DC", "District of Columbia"),
        ("PR", "Puerto Rico"), ("VI", "U.S. Virgin Islands"), ("GU", "Guam"),
        ("AS", "American Samoa"), ("MP", "Northern Mariana Islands"),
    };
}
