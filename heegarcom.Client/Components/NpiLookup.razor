@using System.Net.Http.Json
@inject HttpClient Http

<div class="mx-auto max-w-4xl px-6 pb-24">
    <div class="grid gap-3 sm:grid-cols-3">
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">First name</label>
            <input value="@firstName" @oninput="OnFirst" @onkeydown="OnKey" type="search" autocomplete="off"
                   placeholder="e.g. John"
                   class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">Last name</label>
            <input value="@lastName" @oninput="OnLast" @onkeydown="OnKey" type="search" autocomplete="off"
                   placeholder="e.g. Smith"
                   class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange" />
        </div>
        <div>
            <label class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted">State</label>
            <select value="@stateText" @onchange="OnState"
                    class="w-full rounded-md border border-line bg-white px-4 py-3 text-ink shadow-sm outline-none transition-colors focus:border-orange">
                <option value="">Any state</option>
                @foreach (var s in States)
                {
                    <option value="@s.Code">@s.Code &mdash; @s.Name</option>
                }
            </select>
        </div>
    </div>

    <button @onclick="OnSearch" disabled="@(!CanSearch || loading)"
            class="mt-4 rounded-md bg-orange px-6 py-2.5 text-sm font-medium text-white transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50">
        Search
    </button>

    @if (loading)
    {
        <p class="mt-4 text-sm text-muted">Searching…</p>
    }
    else if (error)
    {
        <p class="mt-4 text-sm text-muted">Lookup failed — please try again.</p>
    }
    else if (searched && rows.Count == 0)
    {
        <p class="mt-4 text-sm text-muted">No matches. Try a last name or a 2-letter state.</p>
    }
    else if (rows.Count > 0)
    {
        <p class="mt-4 text-sm text-muted">@rows.Count result@(rows.Count == 1 ? "" : "s")@(rows.Count == 200 ? " (showing first 200)" : "")</p>
        <div class="mt-3 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
                <thead>
                    <tr class="border-b border-line text-xs uppercase tracking-widest text-muted">
                        <th class="w-8 py-2"></th>
                        <th class="py-2 pr-4">NPI</th>
                        <th class="py-2 pr-4">Name</th>
                        <th class="py-2 pr-4">Type</th>
                        <th class="py-2 pr-4">Primary specialty</th>
                        <th class="py-2 pr-4">Location</th>
                        <th class="py-2">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var isOpen = expanded.Contains(r.Npi);
                        <tr class="border-b border-line align-top">
                            <td class="py-2 pr-2">
                                <button @onclick="() => ToggleAsync(r.Npi)" aria-label="Toggle provider detail"
                                        class="text-muted transition-colors hover:text-orange">
                                    <span class="inline-block transition-transform @(isOpen ? "rotate-90" : "")">&#9656;</span>
                                </button>
                            </td>
                            <td class="whitespace-nowrap py-2 pr-4 font-mono font-medium text-navy">@r.Npi</td>
                            <td class="py-2 pr-4 text-ink">
                                @r.Name
                                @if (r.Also.Length > 0)
                                {
                                    <span class="block text-xs italic text-muted">@r.Also</span>
                                }
                            </td>
                            <td class="whitespace-nowrap py-2 pr-4 text-muted">@r.Type</td>
                            <td class="py-2 pr-4 text-ink">@r.Specialty</td>
                            <td class="whitespace-nowrap py-2 pr-4 text-muted">@LocationText(r)</td>
                            <td class="whitespace-nowrap py-2 text-muted">@r.Status</td>
                        </tr>
                        @if (isOpen)
                        {
                            var st = details.TryGetValue(r.Npi, out var d) ? d : null;
                            <tr class="border-b border-line bg-navy/5">
                                <td colspan="7" class="px-6 py-5">
                                    @if (st is null || st.Loading)
                                    {
                                        <p class="text-sm text-muted">Loading provider detail…</p>
                                    }
                                    else if (st.Error)
                                    {
                                        <p class="text-sm text-muted">Couldn't load detail — please try again.</p>
                                    }
                                    else
                                    {
                                        <div class="grid gap-6 sm:grid-cols-2">
                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">
                                                    Medicare@(st.Data?.Medicare is not null ? $" ({st.Data.Medicare.Year})" : "")
                                                </h4>
                                                @if (st.Data?.MedicareFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load Medicare data — collapse and reopen to retry.</p>
                                                }
                                                else if (st.Data?.Medicare is { } med)
                                                {
                                                    <div class="mt-3 grid grid-cols-2 gap-3">
                                                        @Tile($"{med.Beneficiaries:N0}", "Medicare patients")
                                                        @Tile($"{med.Services:N0}", "Services")
                                                        @Tile($"${med.TotalPaid:N0}", "Medicare paid")
                                                        @Tile($"${med.TotalAllowed:N0}", "Allowed")
                                                    </div>
                                                    <p class="mt-2 text-xs text-muted">@med.ProviderType &middot; avg patient age @med.AvgAge</p>
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No Medicare Part B billing on record.</p>
                                                }
                                            </div>
                                            <div>
                                                <h4 class="text-xs font-semibold uppercase tracking-widest text-orange">
                                                    Industry payments@(st.Data?.OpenPayments is not null ? $" ({st.Data.OpenPayments.Year})" : "")
                                                </h4>
                                                @if (st.Data?.OpenPaymentsFailed == true)
                                                {
                                                    <p class="mt-3 text-sm text-muted">Couldn't load payment data — collapse and reopen to retry.</p>
                                                }
                                                else if (st.Data?.OpenPayments is { } op)
                                                {
                                                    <div class="mt-3 grid grid-cols-2 gap-3">
                                                        @Tile($"{(op.Capped ? "≥ $" : "$")}{op.TotalReceived:N0}", op.Capped ? "Total received (partial)" : "Total received")
                                                        @Tile($"{op.PaymentCount:N0}{(op.Capped ? "+" : "")}", "Payments")
                                                    </div>
                                                    @if (op.TopNatures.Length > 0)
                                                    {
                                                        <p class="mt-2 text-xs text-muted">Top: @string.Join(", ", op.TopNatures)</p>
                                                    }
                                                    @if (op.TopManufacturers.Length > 0)
                                                    {
                                                        <p class="mt-1 text-xs text-muted">From: @string.Join(", ", op.TopManufacturers)</p>
                                                    }
                                                    @if (op.Capped)
                                                    {
                                                        <p class="mt-1 text-xs text-muted">Very high payment volume — figures reflect the first @op.PaymentCount records.</p>
                                                    }
                                                }
                                                else
                                                {
                                                    <p class="mt-3 text-sm text-muted">No industry payments reported.</p>
                                                }
                                            </div>
                                        </div>
                                        <p class="mt-4 text-xs text-muted">Source: CMS — each figure reflects the latest published program year, shown above.</p>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string firstName = "";
    private string lastName = "";
    private string stateText = "";
    private List<NpiRow> rows = new();
    private bool loading;
    private bool searched;
    private bool error;

    private bool CanSearch => lastName.Trim().Length >= 2 || stateText.Trim().Length == 2;

    private void OnFirst(ChangeEventArgs e) => firstName = e.Value?.ToString() ?? "";
    private void OnLast(ChangeEventArgs e) => lastName = e.Value?.ToString() ?? "";
    private void OnState(ChangeEventArgs e) => stateText = e.Value?.ToString() ?? "";

    private Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            return OnSearch();
        return Task.CompletedTask;
    }

    private async Task OnSearch()
    {
        if (!CanSearch)
            return;

        loading = true;
        error = false;
        expanded.Clear();
        details.Clear();
        StateHasChanged();

        var url = $"api/npi/search?firstName={Uri.EscapeDataString(firstName.Trim())}"
                + $"&lastName={Uri.EscapeDataString(lastName.Trim())}"
                + $"&state={Uri.EscapeDataString(stateText.Trim())}";

        try
        {
            var found = await Http.GetFromJsonAsync<List<NpiRow>>(url);
            rows = found ?? new();
            searched = true;
        }
        catch
        {
            rows = new();
            error = true;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string LocationText(NpiRow r)
    {
        if (r.City.Length > 0 && r.State.Length > 0)
            return $"{r.City}, {r.State}";
        return r.City.Length > 0 ? r.City : r.State;
    }

    // --- Per-provider detail expander (Medicare + Open Payments, lazy-loaded and cached per NPI) ---

    private readonly HashSet<string> expanded = new();
    private readonly Dictionary<string, DetailState> details = new();

    private async Task ToggleAsync(string npi)
    {
        if (expanded.Contains(npi))
        {
            expanded.Remove(npi);
            return;
        }

        expanded.Add(npi);
        // Re-fetch when there's no cached state, or the last attempt errored (so a failure is retryable
        // by collapsing and reopening). A successful or in-flight state is reused.
        if (details.TryGetValue(npi, out var existing) && !existing.Error)
            return;

        var st = new DetailState { Loading = true };
        details[npi] = st;
        StateHasChanged();

        try
        {
            st.Data = await Http.GetFromJsonAsync<ProviderDetails>($"api/npi/details?npi={Uri.EscapeDataString(npi)}");
        }
        catch
        {
            st.Error = true;
        }
        finally
        {
            st.Loading = false;
            StateHasChanged();
        }
    }

    private RenderFragment Tile(string value, string label) => @<div class="rounded-lg bg-white p-3 shadow-sm">
        <div class="text-lg font-bold text-orange">@value</div>
        <div class="mt-0.5 text-xs leading-snug text-muted">@label</div>
    </div>;

    private sealed class DetailState
    {
        public bool Loading;
        public bool Error;
        public ProviderDetails? Data;
    }

    private record NpiRow(string Npi, string Name, string Also, string Type, string Specialty, string City, string State, string Status);

    private record ProviderDetails(
        MedicareSummary? Medicare, bool MedicareFailed,
        OpenPaymentsSummary? OpenPayments, bool OpenPaymentsFailed);

    private record MedicareSummary(
        int Year, string ProviderType, int Beneficiaries, int Services,
        decimal TotalPaid, decimal TotalAllowed, decimal DrugPaid, decimal MedicalPaid, int AvgAge);

    private record OpenPaymentsSummary(
        int Year, decimal TotalReceived, int PaymentCount, bool Capped,
        string[] TopNatures, string[] TopManufacturers);

    private static readonly (string Code, string Name)[] States =
    {
        ("AL", "Alabama"), ("AK", "Alaska"), ("AZ", "Arizona"), ("AR", "Arkansas"),
        ("CA", "California"), ("CO", "Colorado"), ("CT", "Connecticut"), ("DE", "Delaware"),
        ("FL", "Florida"), ("GA", "Georgia"), ("HI", "Hawaii"), ("ID", "Idaho"),
        ("IL", "Illinois"), ("IN", "Indiana"), ("IA", "Iowa"), ("KS", "Kansas"),
        ("KY", "Kentucky"), ("LA", "Louisiana"), ("ME", "Maine"), ("MD", "Maryland"),
        ("MA", "Massachusetts"), ("MI", "Michigan"), ("MN", "Minnesota"), ("MS", "Mississippi"),
        ("MO", "Missouri"), ("MT", "Montana"), ("NE", "Nebraska"), ("NV", "Nevada"),
        ("NH", "New Hampshire"), ("NJ", "New Jersey"), ("NM", "New Mexico"), ("NY", "New York"),
        ("NC", "North Carolina"), ("ND", "North Dakota"), ("OH", "Ohio"), ("OK", "Oklahoma"),
        ("OR", "Oregon"), ("PA", "Pennsylvania"), ("RI", "Rhode Island"), ("SC", "South Carolina"),
        ("SD", "South Dakota"), ("TN", "Tennessee"), ("TX", "Texas"), ("UT", "Utah"),
        ("VT", "Vermont"), ("VA", "Virginia"), ("WA", "Washington"), ("WV", "West Virginia"),
        ("WI", "Wisconsin"), ("WY", "Wyoming"), ("DC", "District of Columbia"),
        ("PR", "Puerto Rico"), ("VI", "U.S. Virgin Islands"), ("GU", "Guam"),
        ("AS", "American Samoa"), ("MP", "Northern Mariana Islands"),
    };
}
